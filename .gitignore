# ============================================================
# VARIÁVEIS DE AMBIENTE
# O .env tem as chaves do Supabase usadas pelo Vercel.
# Mantenha uma cópia local — o Vercel lê daqui em produção.
# NUNCA commite .env.local ou arquivos com service_role keys.
# ============================================================
# .env  ← mantido no repo (só chaves públicas/publishable)
.env.local
.env.*.local
.dev.vars

# ============================================================
# CLOUDFLARE / WRANGLER
# ============================================================
.wrangler/

